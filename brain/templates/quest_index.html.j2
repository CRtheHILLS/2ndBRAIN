<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ plan.title_ko }} · 2nd BRAIN 퀘스트</title><link rel="stylesheet" href="../../brain.css"></head>
<body class="quest">
<header>
  <a href="../../index.html">← 서재</a>
  <p class="kicker">🗺️ {{ days|length }}일 퀘스트</p>
  <h1>{{ plan.title_ko }}</h1>
  <p class="goal">{{ plan.one_line_goal }}</p>
</header>
<main>
  {% set h = plan.honesty or {} %}
  {% if h.learnable_by_reading or h.needs_practice or h.hype_warning %}
  <section class="honesty">
    <h2>🧭 정직 상자</h2>
    {% if h.learnable_by_reading %}<h3>📚 읽어서 되는 것</h3><ul>{% for x in h.learnable_by_reading %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
    {% if h.needs_practice %}<h3>🤲 몸으로 해야 하는 것</h3><ul>{% for x in h.needs_practice %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
    {% if h.hype_warning %}<h3>⚠️ 과장 주의</h3><ul>{% for x in h.hype_warning %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}
  </section>
  {% endif %}

  <section>
    <h2>👣 지도</h2>
    <p class="progress"><b>{{ n_ready }} / {{ days|length }}</b>일 수업 준비됨</p>
    <progress max="{{ days|length }}" value="{{ n_ready }}"></progress>
    <ol class="path">
      {% for d in days %}
      <li class="{{ 'ready' if d.ready else 'todo' }}">
        <span class="step">{{ d.n }}</span>
        <div>{% if d.ready %}<a href="day-{{ d.n }}.html"><b>Day {{ d.n }}</b> · {{ d.big_idea }}</a>{% if d.one_line and d.one_line != d.big_idea %}<small>{{ d.one_line }}</small>{% endif %}
        {% else %}<b>Day {{ d.n }}</b> · {{ d.big_idea }}<small>아직 준비 중이에요</small>{% endif %}</div>
      </li>
      {% endfor %}
    </ol>
  </section>

  <section>
    <h2>📎 출처 장부</h2>
    {% if sources %}
    <div class="table-wrap"><table>
      <thead><tr><th>자료</th><th>종류</th><th>어디서</th><th>날</th><th>왜 골랐나</th></tr></thead>
      <tbody>{% for s in sources %}<tr>
        <td>{% if s.url.startswith(("http://", "https://")) %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.title or s.url }}</a>{% else %}{{ s.title or s.url }}{% endif %}</td>
        <td>{{ s.kind }}</td><td>{{ s.connector }}</td><td>{{ s.day or "특별" }}</td><td>{{ s.why_picked }}</td>
      </tr>{% endfor %}</tbody>
    </table></div>
    {% else %}<p class="muted">아직 모은 자료가 없어요.</p>{% endif %}

    {% if ledger.vault_hits %}
    <h3>🏠 이미 내 서재에 있던 자료</h3>
    <ul>{% for v in ledger.vault_hits %}<li>{% if v.url and v.url.startswith(("http://", "https://")) %}<a href="{{ v.url }}" target="_blank" rel="noopener">{{ v.title or v.url }}</a>{% else %}{{ v.title or v.path or v.url }}{% endif %}{% if v.dot %} <span class="muted">· {{ v.dot }}</span>{% endif %}</li>{% endfor %}</ul>
    {% endif %}
  </section>

  {% if ledger.new_connectors_tried or ledger.special_tried %}
  <section>
    <h2>🧪 이번에 새로 시도한 출처</h2>
    {% if ledger.new_connectors_tried %}<p>결과를 준 연결기: {{ ledger.new_connectors_tried|join(", ") }}</p>{% endif %}
    {% if ledger.special_tried %}<ul>{% for sp in ledger.special_tried %}<li><b>{{ sp.name }}</b> — {% if sp.ok %}✅ 가져왔어요{% else %}❌ {{ sp.reason or "못 가져왔어요" }}{% endif %}{% if sp.why %} <span class="muted">({{ sp.why }})</span>{% endif %}</li>{% endfor %}</ul>{% endif %}
  </section>
  {% endif %}

  <section>
    <h2>🌉 다른 때 배운 것과 잇기</h2>
    {% if bridges %}<ul>{% for b in bridges %}<li><b>{{ b.src_label }}</b> ↔ <b>{{ b.dst_label }}</b>{% if b.reason %} — {{ b.reason }}{% endif %}</li>{% endfor %}</ul>
    {% else %}<p class="muted">아직 없어요. 다른 주제를 배우면 여기에 저절로 이어져요.</p>{% endif %}
  </section>
</main>
<footer><a href="../../index.html">← 서재로 돌아가기</a></footer>
</body></html>
